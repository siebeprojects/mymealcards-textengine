{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Schema for products.core.json — product definitions referencing a card",
  "type": "object",
  "patternProperties": {
    "^[a-z0-9_]+$": {
      "type": "object",
      "required": ["card"],
      "properties": {
        "card": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
