{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Schema for languages.{lang}.json — localized language label per language code",
  "type": "object",
  "patternProperties": {
    "^[a-z]{2}$": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
