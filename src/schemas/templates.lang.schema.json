{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Schema for templates.{lang}.json — localized template strings with DSL placeholders",
  "type": "object",
  "patternProperties": {
    "^[a-z0-9_]+$": {
      "type": "object",
      "required": ["template"],
      "properties": {
        "template": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
